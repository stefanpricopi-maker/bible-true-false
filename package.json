{
  "name": "bible-true-false",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "npm run sync:sfx && vite",
    "build": "npm run sync:sfx && tsc && vite build",
    "preview": "vite preview",
    "test": "node scripts/smoke-check.mjs && npx --yes vite-node scripts/sim-session.mjs",
    "deploy:cf": "npm run build && npx wrangler pages deploy dist --project-name=bible-true-false",
    "analytics:enable": "node scripts/enable-cf-web-analytics.mjs",
    "gen:audio": "node scripts/gen-placeholder-audio.mjs",
    "gen:questions": "node scripts/generate-question-audio.mjs",
    "gen:system-vo": "node scripts/generate-system-vo.mjs",
    "sync:batch": "node scripts/sync-batch-to-pack.mjs",
    "sync:sfx": "node scripts/sync-sfx.mjs"
  },
  "devDependencies": {
    "typescript": "~5.9.3",
    "vite": "^7.3.1",
    "vite-plugin-pwa": "^1.3.0"
  }
}
